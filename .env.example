# AI provider for explanations, quick actions, condensing and the chat (none set: AI is off, unless ROUTER_API_KEY is set).
#   agent-sdk  – Claude Agent SDK with this machine's Claude Code login, no key needed (counts against your plan's limits)
#   anthropic  – Claude API, needs ANTHROPIC_API_KEY (billed per token)
#   router     – your own OpenAI-compatible router, needs ROUTER_URL and ROUTER_API_KEY
AI_PROVIDER=agent-sdk

# Models: short name (opus, sonnet, haiku) or a full model ID. AI_MODEL for the background explanations,
# AI_MODEL_EDIT for quick actions, condensing and the chat.
AI_MODEL=opus
AI_MODEL_EDIT=opus

# Only for AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only for AI_PROVIDER=router
ROUTER_URL=
ROUTER_API_KEY=

# Folders with your projects whose skills (linked into ~/.claude/skills) may be edited here, e.g. ~/projects.
# Separate several like PATH (":", on Windows ";"); "~" stands for your home folder.
# Without it, linked skills outside ~/.claude are read-only.
PROJECT_ROOTS=

# Port of the local server (default 8795).
# PORT=8795
