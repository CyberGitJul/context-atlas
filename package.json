{
  "name": "context-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "See everything that shapes Claude Code (CLAUDE.md, rules, skills, hooks, subagents, MCP, plugins, memory) and improve it with Claude itself. A local web app.",
  "license": "MIT",
  "author": "the Context Atlas contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberGitJul/context-atlas.git"
  },
  "homepage": "https://github.com/CyberGitJul/context-atlas#readme",
  "bugs": {
    "url": "https://github.com/CyberGitJul/context-atlas/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "claude-md",
    "skills",
    "hooks",
    "mcp",
    "context",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "codemirror": "^6.0.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
